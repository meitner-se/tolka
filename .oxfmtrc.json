{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "es5",
    "arrowParens": "always",
    "printWidth": 80,
    "sortPackageJson": false,
    "ignorePatterns": ["*.yaml", "src/vendor/**", "coverage/**", "dist/**"],
    "sortImports": {
        "groups": [
            "type-import",
            ["value-builtin", "value-external"],
            "type-internal",
            "value-internal",
            ["type-parent", "type-sibling", "type-index"],
            ["value-parent", "value-sibling", "value-index"],
            "unknown"
        ]
    }
}
