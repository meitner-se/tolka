{
    "name": "@meitner/tolka",
    "version": "0.2.1",
    "description": "Typesafe ICU message formatting with direct imports, no registry and no build step.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meitner-se/tolka.git"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        },
        "./eslint-plugin": {
            "types": "./dist/eslint-plugin/index.d.ts",
            "default": "./dist/eslint-plugin/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "vitest",
        "lint": "oxlint --type-aware && oxfmt --check .",
        "format": "oxfmt .",
        "typecheck": "tsc --noEmit",
        "prepack": "tsc --project tsconfig.build.json",
        "changeset": "changeset",
        "release": "changeset publish",
        "lint:fix": "oxlint --type-aware --fix . && oxfmt .",
        "test:package": "tsc --project tsconfig.build.json && node scripts/smoke.mjs",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "intl-messageformat": "^10.7.18"
    },
    "peerDependencies": {
        "eslint": ">=9",
        "react": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "eslint": {
            "optional": true
        }
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.0",
        "@changesets/cli": "^2.27.0",
        "@formatjs/icu-messageformat-parser": "2.11.4",
        "@types/eslint": "^9.6.1",
        "@types/estree": "^1.0.9",
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitest/coverage-v8": "3.2.7",
        "eslint": "^9.39.5",
        "oxfmt": "0.57.0",
        "oxlint": "1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "~5.9.3",
        "vitest": "^3.0.0"
    },
    "packageManager": "pnpm@11.1.2"
}
